#!/bin/bash

#
# OVERVIEW
#  Sets up MTUQ for a given seismic event
#

#
# USAGE
#   To specify the event, it is possible to pass a preliminary origin time,
#   location and magnitude as follows:
#
#     new_project <UTC_DATE_TIME> <LAT>  <LON>  <DEPTH_IN_KM>  <MAGNITUDE>
#
#   Or if event already exists in a local database, it may be possible to simply
#   pass an event ID:
#
#     new_project <EVENT_ID>
#
#
#   The result of either of the above is a set of scripts that can be used to
#   set up and run MTUQ.
#
#   For further usage illustration, please see: MTUQ_Automater/example


#
# EXAMPLES
#   >> new_project  2017-09-03T03:30:01.000  41.300  129.078  1.  5.42
#   >> new_project  2017-09-03T03:30:01  41.300  129.078  1.  5.42
#   >> new_project  2017,09,03,03,30,01  41.300  129.078  1.  5.42
#   >> new_project  2017-09-03__03-30-01  41.300  129.078  1.  5.42
#
#   >> new_project 20170903033001
#   >> new_project c7a0c09f172abd32e
#



function new_bash_script {
	filename="$1"
	bin="$2"
	arg="$3"
	cat <<-EOF > $filename
	#/bin/bash
	$bin $arg
	EOF
        chmod u+x $filename
}

function is_url {
	if curl --head --silent --fail $1 &> /dev/null; then
	    return 0
	  else
	    return 1
	  fi
}


#
# event file
#
if $(is_url  $1)
then
    download $1
    event_file=$(basename $1)

else
    event_name=$(new_event $@)
    event_file="${event_name}.yaml"

fi
echo $event_name


#
# create scripts
#
wrapper="01_pull"
cmd="pull_fdsn"
arg="$event_file"
new_bash_script $wrapper $cmd $arg


wrapper="02_setup"
cmd="mtuq_setup"
arg="$event_file"
new_bash_script $wrapper $cmd $arg


wrapper="03_run"
cmd="mtuq_run"
arg="$event_file"
new_bash_script $wrapper $cmd $arg


