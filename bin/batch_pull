#!/usr/bin/env python


import os
import pandas as pd
import sys
import yaml

from copy import deepcopy
from obspy import UTCDateTime
from os.path import abspath, join

from mtuq_automater.parsers import event_parser, event_tagger


def read_csv(*args, **kwargs):
    defaults = {'comment':'#', 'header':None, 'sep':r'\s+'}
    defaults.update(**kwargs)
    return pd.read_csv(*args, **defaults)



verbose = 1



if __name__=='__main__':
    """  Pulls waveforms for multiple events


    USAGE 1:
      >> batch_pull events.tsv


      Stores the waveforms in a directory tree

        event1/
        event2/
        ...

      where each <event> directory corresponds to an entry in events.tsv


    USAGE 2:
      >> batch_pull events.tsv templates.tsv

      Stores the waveforms in a directory tree

	event1/
	    pull1/
	    pull2/
	    ...
	
	event2/
	    pull1/
	    pull2/
	    ...

      where each <event> directory corresponds to an entry in events.tsv and 
      each <pull> subdirectory corresponds to an entry in templates.tsv

    """

    args = sys.argv[1:]

    if len(args) < 1:
        raise Exception('Two few input arguments')
    elif len(args) > 3:
        raise Exception('Two many input arguments')


    # parse events file
    names=['utc_datetime_str', 'latitude', 'longitude', 'depth_in_km', 'magnitude']
    events = read_csv(args[0], names=names)


    if len(args) > 1:
	# parse optional templates file
        filename = args[1]
        templates = read_csv(filename)
    else:
        templates = [None]


    for _i, row in events.iterrows():

        dirname = event_tagger(*row)
        if verbose > 0:
            print(dirname)

        os.makedirs(dirname)

        for template in templates:

            # write configuration file
            event_parser(*row, template=template, verbose=0, write_yaml=True)

            #
            # download waveforms
            #

            # FDSN pull
            #pull_fdsn()

            # database pull
            #pull_db()


