#!/usr/bin/env python


import sys

from mtuq_automater.parsers import event_namer, config_parser
from mtuq_automater.yaml import write_yaml



if __name__=='__main__':
    """ Creates an event file from origin time and location or other information
      passed over the command line

      The resulting event file can then be used to download waveforms 

         >> pull <event_file>

      or to setup an inversion
 
         >> setup <event_file>


    USAGE
      >> new_event <UTC_DATE_TIME> <LAT>  <LON>  <DEPTH_IN_KM>  <MAGNITUDE>

      >> new_event <DATABASE_ID>
    
    
    EXAMPLES
      >> new_event  2017-09-03T03:30:01.000  41.300  129.078  1.  5.42
      >> new_event  2017-09-03T03:30:01  41.300  129.078  1.  5.42
      >> new_event  2017-09-03_03:30:01  41.300  129.078  1.  5.42
      >> new_event  2017,09,03,03,30,01  41.300  129.078  1.  5.42
      >> new_event  2017-09-03--03-30-01  41.300  129.078  1.  5.42

      >> new_event 20170903033001
      >> new_event c7a0c09f172abd32e


    WARNING
        The details of the script itself and of the resulting output file are 
        still a work in progress

        In particular, the key/value schema, including the names of keys and
        formatting of values, may change without notice

    """
    
    args = sys.argv[1:]

    if len(args) == 1:
        # parse event ID from local database
        raise Exception('event ID lookup not yet implemented')

    elif len(args) == 5:
        origin = {
            'datetime': args[0],
            'latitude': float(args[1]),
            'longitude': float(args[2]),
            'depth_in_km': float(args[3]),
            'magnitude': float(args[4]),
            }

    else:
        raise Exception('unexpected number of input arguments')


    # construct event name
    name = event_namer(**origin)

    # write event file
    write_yaml(name+'.yaml', config_parser(name=name, **origin))

    print(name)

