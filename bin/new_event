#!/usr/bin/env python

import os
import sys

from mtuq_automater.parsers import event_namer, event_parser
from mtuq_automater.utils import bash_wrapper
from mtuq_automater.utils.yaml import write_yaml
from os.path import exists



if __name__=='__main__':
    """ Accepts an origin time and location passed over the command line

        >> new_event <UTC_DATE_TIME> <LAT>  <LON>  <DEPTH_IN_KM>  <MAGNITUDE>

    Or if the event already exists in a local database, it may be possible to
    simply pass an event ID:

        >> new_event <EVENTID>

    The result is a customizable event file and a set of scripts that can used
    to set up and run a moment tensor analysis.


    EXAMPLES
      >> new_event  2017-09-03T03:30:01.000  41.300  129.078  1.  5.42
      >> new_event  2017-09-03T03:30:01  41.300  129.078  1.  5.42
      >> new_event  2017-09-03_03:30:01  41.300  129.078  1.  5.42
      >> new_event  2017,09,03,03,30,01  41.300  129.078  1.  5.42
      >> new_event  2017-09-03--03-30-01  41.300  129.078  1.  5.42
      >> new_event  20170903033001
      >> new_event  c7a0c09f172abd32e


    WARNING
        The details of the script itself and of the resulting output file are 
        still a work in progress

        In particular, the key/value schema, including the names of keys and
        formatting of values, may change without notice

    """
    
    args = sys.argv[1:]

    if len(args) == 1:
        # parse event ID from local database
        raise Exception('event ID lookup not yet implemented')

    elif len(args) == 5:
        origin = {
            'datetime': args[0],
            'latitude': float(args[1]),
            'longitude': float(args[2]),
            'depth_in_km': float(args[3]),
            'magnitude': float(args[4]),
            }

    else:
        raise Exception('unexpected number of input arguments')


    event_name = event_namer(**origin)
    event_dict = event_parser(name=event_name, **origin)
    event_dir  = event_name

    config_fdsn = 'config_fdsn.yaml'
    config_db   = 'config_db.yaml'

    # write event file
    os.mkdir(event_dir)
    os.chdir(event_dir)

    if exists(config_fdsn):
        print(f'File exists: {config_fdsn}\nAborting...')
        sys.exit(-1)

    write_yaml(config_fdsn, event_dict)

    # create scripts
    filename=f"01_pull"
    cmd="pull_fdsn"
    bash_wrapper(filename, cmd, config_fdsn)

    filename=f"02_setup"
    cmd="setup"
    bash_wrapper(filename, cmd, config_fdsn, 'waveforms_fdsn')

    filename=f"03_run"
    cmd="run__"
    bash_wrapper(filename, cmd, 'run__*')



