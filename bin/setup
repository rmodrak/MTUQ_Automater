#!/usr/bin/env python

import os
import sys

from os.path import isdir, exists, splitext
from mtuq_automater import setup




if __name__=='__main__':

    #
    # OVERVIEW
    #   Generates MTUQ scripts by substituting event-specific values into
    #   a region-specific template
    #

    #
    # USAGE
    #   Suppose that we have already pulled waveforms for a given event
    #   using an event_file.  We can then generate MTUQ scripts by running
    #
    #     >> setup  EVENT_FILE EVENT_DIR [OUTPUT_DIR] [TEMPLATE]
    #
    #  

    #
    # NOTES
    #   If no user-supplied template files are given, the script generator
    #   will try to construct a templates based on
    #  
    #    - proximity of the event to known sites of interest
    #      (see templates/sites)
    #
    #    - Flinn-Engdahl regionalization (see templates/flinn_engdahl)
    #
    #    - If the event occurs away from any currently implemented sites or 
    #      regions, the script generator falls back to a 1D reference model
    #

    args = sys.argv[1:]
    if len(args) < 1:
        raise Exception('Too few input arguments')
    elif len(args) > 3:
        raise Exception('Too many input arguments')


    if len(args) == 1:
        input_file = sys.argv[1]
        input_dir = splitext(input_file)[0]
        output_dir = os.getcwd()

    elif len(args) == 2:
        input_file = sys.argv[1]
        input_dir = sys.argv[2]
        output_dir = os.getcwd()

    elif len(args) == 3:
        input_file = sys.argv[1]
        input_dir = sys.argv[2]
        output_dir = sys.argv[3]


    assert exists(input_file)
    assert isdir(input_dir)
    assert isdir(output_dir)

    setup(input_file, input_dir, output_dir)

